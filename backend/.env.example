# ==============================================================================
# VEKTOR / JOB MATCHER — Configurações de Ambiente (.env)
# ==============================================================================
# Copie este arquivo para .env neste diretório e preencha suas chaves.
# Exemplo: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Inteligência Artificial (Google Gemini & Ollama)
# ------------------------------------------------------------------------------
# Provedor padrão de IA: "gemini" (cloud) ou "ollama" (local)
IA_PROVIDER=gemini

# Chave de API do Google Gemini (obtenha gratuitamente em https://aistudio.google.com/)
GEMINI_API_KEY=sua_chave_gemini_aqui

# Modelo Gemini primário e modelo de fallback em caso de indisponibilidade
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite

# Modelo local do Ollama (caso IA_PROVIDER=ollama ou fallback)
OLLAMA_MODEL=llama3.2

# Timeout máximo em segundos para respostas de IA
IA_TIMEOUT_SEGUNDOS=30

# ------------------------------------------------------------------------------
# 2. APIs de Busca de Vagas (Opcional - caso ausente, usa mock/heurística)
# ------------------------------------------------------------------------------
# Jooble Job Search API (obtenha chave em https://br.jooble.org/api/about)
JOOBLE_API_KEY=

# Adzuna Job Search API (obtenha em https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Localização geográfica padrão para busca de oportunidades
PAIS=br
LOCALIZACAO=São Paulo
DISTANCIA_KM=15

# ------------------------------------------------------------------------------
# 3. Servidor, CORS & Upload
# ------------------------------------------------------------------------------
# Origens permitidas para requisições cross-origin (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Limite máximo para upload de currículo em PDF (em Megabytes)
TAMANHO_MAXIMO_MB=8
