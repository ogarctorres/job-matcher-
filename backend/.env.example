# === IA (escolha um ou ambos) ===
GEMINI_API_KEY=sua_gemini_key_aqui
IA_PROVIDER=gemini
OLLAMA_MODEL=llama3.2

# === Busca de Vagas ===
# Jooble (fonte principal) — registre em https://br.jooble.org/api/about
JOOBLE_API_KEY=sua_jooble_key_aqui

# Adzuna (fallback) — registre em https://developer.adzuna.com
ADZUNA_APP_ID=sua_app_id_aqui
ADZUNA_APP_KEY=sua_app_key_aqui

# === Localização ===
PAIS=br
LOCALIZACAO=São Paulo
DISTANCIA_KM=15

# === CORS (separar múltiplas origens por vírgula) ===
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# === Upload ===
TAMANHO_MAXIMO_MB=8
