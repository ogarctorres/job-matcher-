# ==============================================================================
# VEKTOR CARREIRAS - VARIÁVEIS DE AMBIENTE (FRONTEND)
# ==============================================================================
# AVISO DE SEGURANÇA:
# Este repositório é público. NUNCA insira chaves reais, segredos ou tokens neste arquivo.
# Para configurar seu ambiente local:
# 1. Crie um projeto gratuito em https://supabase.com
# 2. Copie este arquivo: cp .env.example .env
# 3. Preencha os valores abaixo no seu arquivo .env (que é ignorado pelo Git)
# ==============================================================================

# URL da API do seu projeto Supabase (Project Settings > API > Project URL)
VITE_SUPABASE_URL=

# Chave anônima pública (anon / public key) protegida por Row Level Security (RLS)
VITE_SUPABASE_ANON_KEY=

# Endpoint da API FastAPI backend (Local: http://127.0.0.1:8000)
VITE_API_URL=http://127.0.0.1:8000
